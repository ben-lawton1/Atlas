# Copy to .env (git-ignored) to override the defaults used by compose.yaml.

# The brain folder (mounted read-only at /aios). Default: /home/ben/Atlas/aios
AIOS_DIR=/home/ben/Atlas/aios

# Address Atlas listens on. 127.0.0.1 until remote access and auth are designed (D10).
ATLAS_BIND=127.0.0.1

# Where the browser reaches the terminal bridge (atlas-terminal, D28). The bridge itself only listens on loopback.
ATLAS_TERMINAL_URL=http://127.0.0.1:7681
