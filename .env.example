# Copy to .env (git-ignored) to override the defaults used by compose.yaml.

# The brain folder (mounted read-only at /aios). Default: C:/Users/lawto/aios
AIOS_DIR=C:/Users/lawto/aios

# Address Atlas listens on. 127.0.0.1 until remote access and auth are designed (D10).
ATLAS_BIND=127.0.0.1

# What the Atlas backend calls to read Chalk's library (server to server, from inside the container).
CHALK_API_URL=http://host.docker.internal:8080

# What the browser loads in the Chalk iframe, and the only origin Atlas accepts messages from.
CHALK_PUBLIC_URL=http://localhost:8080
